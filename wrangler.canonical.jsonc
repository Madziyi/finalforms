{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecc-operator-pwa-v1-canonical",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-03",
  "observability": { "enabled": true },
  "vars": {
    "APP_PROTOCOL_VERSION": "3",
    "APP_SCHEMA_VERSION": "3",
    "PLANT_TIME_ZONE": "America/Toronto",
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["45 5 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecc-operator-v1-canonical",
      "database_id": "e80248dd-c895-4704-b36a-c5abb08bf110",
      "migrations_dir": "migrations-canonical",
      "migrations_table": "d1_migrations"
    }
  ],
  "workflows": [
    {
      "name": "ecc-backup-canonical",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "BackupWorkflow"
    }
  ]
}
